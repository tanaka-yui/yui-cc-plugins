{
  "name": "@tanaka-yui/cmux-team",
  "version": "1.0.0",
  "description": "Multi-agent development orchestration with Claude Code + cmux. Spawn, monitor, and integrate parallel sub-agents visually in terminal panes.",
  "type": "module",
  "bin": {
    "cmux-team": "bin/cmux-team.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && biome check ./bin ./src",
    "check:fix": "biome check --write ./bin ./src",
    "format": "biome format ./bin ./src",
    "format:fix": "biome format --write ./bin ./src",
    "lint": "biome lint ./bin ./src",
    "lint:fix": "biome lint --write ./bin ./src"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  }
}
