#!/usr/bin/env bash
set -uo pipefail

# cmux-codex-wait — agmsg history を polling し、指定 token を含む完了メッセージが
# 届いたら status=done で exit する短命 watcher。background task として起動され、
# その exit が Claude Code の <task-notification> を発火して idle 親を wake する。
# agmsg 常駐 monitor と違い「完了して exit する」ことが wake の要。
#
# **既定では壁時計で打ち切らない**（--timeout 0）。以前は 1800s で打ち切っていたが、
# codex のレビュー/実装がそれを超えると、まだ生きている codex を見捨てて親の待機が
# 畳まれ、後から届く完了通知では二度と親が起きなかった。cmux-team-dispatch-task の
# monitor-dispatch.sh と同じく「時間ではなく生存」で判断する。
#
# 無制限待機で孤児 watcher が残らないよう、--surface が渡されていれば定期的に
# cmux read-screen でペインの生存を確認し、2 回連続で見つからなければ status=gone
# で exit して親を起こす（socket の一時的な失敗で誤検知しないための 2 回連続）。
#
# Usage: cmux-codex-wait <team> <agent> <token> [options]
#   --surface <id>             生存確認するペイン。消滅時は status=gone / exit 4
#   --timeout <sec>            打ち切り秒数。0 = 無制限 (default: 0)
#   --interval <sec>           history polling 間隔 (default: 5)
#   --liveness-interval <sec>  ペイン生存確認の間隔 (default: 60)
#
# 完了メッセージに agents=<N> が含まれていれば status 行に転記する（codex が spawn した
# 子エージェント数を親セッションへ返すため）。含まれなければ従来どおりの出力になる。
#
# Exit: 0=done / 2=usage・agmsg 無し / 3=timeout / 4=gone

AGMSG_HISTORY="${AGMSG_HISTORY:-$HOME/.agents/skills/agmsg/scripts/history.sh}"
CMUX_BIN="${CMUX_BIN:-cmux}"

TEAM="${1:-}"; AGENT="${2:-}"; TOKEN="${3:-}"
[[ $# -ge 3 ]] && shift 3 || true
TIMEOUT=0
INTERVAL=5
SURFACE=""
LIVENESS_INTERVAL=60
while [[ $# -gt 0 ]]; do
  case "$1" in
    --surface)           SURFACE="$2"; shift 2 ;;
    --timeout)           TIMEOUT="$2"; shift 2 ;;
    --interval)          INTERVAL="$2"; shift 2 ;;
    --liveness-interval) LIVENESS_INTERVAL="$2"; shift 2 ;;
    *) shift ;;
  esac
done

[[ -n "$TEAM" && -n "$AGENT" && -n "$TOKEN" ]] || { echo "status=error reason=usage"; exit 2; }
[[ -x "$AGMSG_HISTORY" ]] || { echo "status=error reason=no-agmsg"; exit 2; }

elapsed=0
since_liveness=0
missed=0
while :; do
  # マッチ行を捕まえるのは、完了通知本文に埋め込まれた agents=N（codex が実際に spawn した
  # 子エージェント数）を親へ渡すため。agents= が無ければ従来どおりの出力になる。
  hit=$("$AGMSG_HISTORY" "$TEAM" "$AGENT" 30 2>/dev/null | grep -F "$TOKEN" | tail -1)
  if [[ -n "$hit" ]]; then
    agents=$(printf '%s' "$hit" | grep -oE 'agents=[0-9]+' | tail -1)
    echo "status=done token=$TOKEN${agents:+ $agents}"
    exit 0
  fi
  sleep "$INTERVAL"
  elapsed=$(( elapsed + INTERVAL ))

  # ペイン生存確認（--surface 指定時のみ）
  if [[ -n "$SURFACE" ]]; then
    since_liveness=$(( since_liveness + INTERVAL ))
    if (( since_liveness >= LIVENESS_INTERVAL )); then
      since_liveness=0
      if "$CMUX_BIN" read-screen --surface "$SURFACE" --lines 1 >/dev/null 2>&1; then
        missed=0
      else
        missed=$(( missed + 1 ))
        if (( missed >= 2 )); then
          echo "status=gone token=$TOKEN surface=$SURFACE"
          exit 4
        fi
      fi
    fi
  fi

  # --timeout を明示したときだけ壁時計で打ち切る（後方互換）
  if (( TIMEOUT > 0 )) && (( elapsed >= TIMEOUT )); then
    break
  fi
done
echo "status=timeout token=$TOKEN"
exit 3
