{
  "name": "@tanaka-yui/cmux-remote-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit && biome check ./src",
    "check:fix": "biome check --write ./src",
    "format": "biome format ./src && biome format ./public",
    "format:fix": "biome format --write ./src",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src"
  },
  "dependencies": {
    "hono": "4.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11"
  }
}
